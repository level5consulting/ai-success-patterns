{"text": "<meta name=\"dash-one-writer\">\n<style>\n#dash-root a.pm-link{display:block;color:var(--color-fg);text-decoration:underline;text-underline-offset:3px;}\n#dash-root a.pm-link:hover{color:var(--color-ok);}\n#dash-root .pm-wrap{font-family:var(--font-anthropic-sans);color:var(--color-fg);display:flex;flex-direction:column;gap:var(--cds-gap-lg);}\n#dash-root .pm-title{font-family:var(--font-anthropic-serif);font-weight:400;font-size:var(--cds-font-size-title);margin:0;}\n#dash-root .pm-take{margin:0;color:var(--color-fg-muted);font-size:var(--cds-font-size-body);}\n#dash-root .pm-take b{color:var(--color-fg);font-weight:600;font-variant-numeric:tabular-nums;}\n#dash-root .pm-card{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);}\n#dash-root .pm-h2{font-size:var(--cds-font-size-heading);font-weight:var(--cds-font-weight-medium);margin:0 0 var(--cds-gap-xs);}\n#dash-root .pm-note{margin:0 0 var(--cds-gap-md);font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);}\n#dash-root .pm-legend{display:flex;flex-wrap:wrap;gap:var(--cds-gap-md);font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);margin:0 0 var(--cds-gap-md);padding:0;list-style:none;}\n#dash-root .pm-legend li{display:flex;align-items:center;gap:6px;}\n#dash-root .dot{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none;}\n#dash-root .s-ok{background:var(--color-ok);} #dash-root .s-warn{background:var(--color-warn);} #dash-root .s-mute{background:var(--cds-chart-muted);}\n#dash-root .pm-board{display:grid;grid-template-columns:minmax(9rem,12rem) repeat(4,minmax(0,1fr));gap:var(--cds-gap-sm);min-height:20rem;}\n#dash-root .pm-colhead{font-size:var(--cds-font-size-caption);font-weight:var(--cds-font-weight-medium);color:var(--color-fg-muted);padding:0 var(--cds-pad-xs) var(--cds-pad-xs);border-bottom:1px solid var(--color-border-line);}\n#dash-root .pm-ws{font-weight:var(--cds-font-weight-medium);font-size:var(--cds-font-size-body);padding:var(--cds-pad-sm) var(--cds-pad-xs);border-top:1px solid var(--color-border-line);}\n#dash-root .pm-cell{display:flex;flex-direction:column;gap:var(--cds-gap-xs);padding:var(--cds-pad-sm) 0;border-top:1px solid var(--color-border-line);}\n#dash-root .pm-item{border:1px solid var(--color-border-line);border-left-width:3px;border-radius:var(--cds-radius);padding:var(--cds-pad-xs) var(--cds-pad-sm);background:var(--color-bg);}\n#dash-root .pm-item.k-ok{border-left-color:var(--color-ok);} #dash-root .pm-item.k-warn{border-left-color:var(--color-warn);} #dash-root .pm-item.k-mute{border-left-color:var(--cds-chart-muted);}\n#dash-root .pm-item .t{font-size:var(--cds-font-size-caption);font-weight:600;line-height:1.3;}\n#dash-root .pm-item .n{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);line-height:1.35;margin-top:2px;}\n#dash-root .pm-item .m{font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);margin-top:4px;display:flex;gap:8px;flex-wrap:wrap;}\n#dash-root .pm-item .tag{font-weight:600;}\n#dash-root .pm-item .tag.k-warn{color:var(--color-warn);} #dash-root .pm-item .tag.k-ok{color:var(--color-ok);}\n#dash-root .pm-mobile-h{display:none;}\n@media (max-width:760px){\n  #dash-root .pm-board{grid-template-columns:1fr;}\n  #dash-root .pm-colhead{display:none;}\n  #dash-root .pm-cell:empty{display:none;}\n  #dash-root .pm-mobile-h{display:block;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);}\n}\n#dash-root .pm-dates{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;}\n#dash-root .pm-dates li{display:grid;grid-template-columns:6.5rem 1fr;gap:var(--cds-gap-sm);padding:var(--cds-pad-xs) 0;border-top:1px solid var(--color-border-line);font-size:var(--cds-font-size-body);}\n#dash-root .pm-dates .d{font-variant-numeric:tabular-nums;color:var(--color-fg-muted);}\n#dash-root .pm-dates .w{color:var(--color-fg-muted);font-size:var(--cds-font-size-caption);}\n</style>\n\n<div class=\"pm-wrap\">\n  <header>\n    <h1 class=\"pm-title\">Plans in motion</h1>\n    <p class=\"pm-take\"><b data-draw=\"nPlans\" data-source=\"summary\" data-field=\"plans\">\u2014</b> plans across <b data-draw=\"nWs\" data-source=\"summary\" data-field=\"workstreams\">\u2014</b> workstreams. <b data-draw=\"nGreg\" data-source=\"summary\" data-field=\"needsGreg\">\u2014</b> need you, and <b data-draw=\"nUpd\" data-source=\"summary\" data-field=\"updateMe\">\u2014</b> need a status update from you. Focus this week: one starter pack done well.</p>\n  </header>\n\n  <section class=\"pm-card\" id=\"board\">\n    <h2 class=\"pm-h2\">The board</h2>\n    <p class=\"pm-note\">Every workstream by when it moves. Ask Claude in chat to add, move or close a plan.</p>\n    <ul class=\"pm-legend\">\n      <li><span class=\"dot s-ok\"></span>On track</li>\n      <li><span class=\"dot s-warn\"></span>Needs you or needs an update</li>\n      <li><span class=\"dot s-mute\"></span>Planned, idea or waiting on others</li>\n    </ul>\n    <div class=\"pm-board\" data-draw=\"board\" data-source=\"plans\" data-row-key=\"id\"></div>\n  </section>\n\n  <section class=\"pm-card\" id=\"dates\">\n    <h2 class=\"pm-h2\">Dates coming up</h2>\n    <p class=\"pm-note\">Plans with a due date, soonest first.</p>\n    <ul class=\"pm-dates\" data-draw=\"dates\" data-source=\"plans\"></ul>\n  </section>\n</div>\n\n<script>\ndash.calc('summary', {\n  inputs: ['plans'],\n  title: 'Plan counts',\n  description: 'Counts plans, workstreams, plans that need Greg, and plans waiting on a status update from him.',\n  fn: (plans) => [{\n    plans: plans.length,\n    workstreams: new Set(plans.map((p) => p.workstream)).size,\n    needsGreg: plans.filter((p) => p.status === 'Needs Greg').length,\n    updateMe: plans.filter((p) => p.status === 'Update me').length,\n  }],\n});\n\nconst kind = (s) => (s === 'On track' ? 'ok' : (s === 'Needs Greg' || s === 'Update me') ? 'warn' : 'mute');\nconst fmtDate = (d) => d3.utcFormat('%a %b %-d')(new Date(d + 'T00:00:00Z'));\nconst H = ['This week', 'Next week', 'Later', 'Waiting'];\n\n['nPlans', 'nWs', 'nGreg', 'nUpd'].forEach((name) => {\n  const field = {nPlans: 'plans', nWs: 'workstreams', nGreg: 'needsGreg', nUpd: 'updateMe'}[name];\n  dash.draw(name, (el) => {\n    const s = dash.data('summary');\n    el.textContent = s.status === 'ok' && s.data[0] ? d3.format(',')(s.data[0][field]) : '\u2014';\n  });\n});\n\ndash.draw('board', (el) => {\n  const d = dash.data('plans');\n  el.replaceChildren();\n  if (d.status !== 'ok') { el.textContent = '\u2014'; return; }\n  const rows = d.data;\n  const order = [];\n  rows.forEach((r) => { if (!order.includes(r.workstream)) order.push(r.workstream); });\n  const add = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };\n  el.appendChild(add('div', 'pm-colhead', ''));\n  H.forEach((h) => el.appendChild(add('div', 'pm-colhead', h)));\n  order.forEach((ws) => {\n    el.appendChild(add('div', 'pm-ws', ws));\n    H.forEach((h) => {\n      const cell = add('div', 'pm-cell');\n      const items = rows.filter((r) => r.workstream === ws && r.horizon === h);\n      if (items.length) cell.appendChild(add('div', 'pm-mobile-h', h));\n      items.forEach((r) => {\n        const k = kind(r.status);\n        const it = add('div', 'pm-item k-' + k);\n        it.dataset.key = r.id;\n        if (r.link) {\n          const a = add('a', 't pm-link', r.plan + (r.status === 'Needs Greg' ? ' - open' : ''));\n          a.href = r.link; a.target = '_blank'; a.rel = 'noopener';\n          it.appendChild(a);\n        } else it.appendChild(add('div', 't', r.plan));\n        if (r.nextStep) it.appendChild(add('div', 'n', r.nextStep));\n        const m = add('div', 'm');\n        m.appendChild(add('span', 'tag k-' + k, r.status));\n        if (r.owner) m.appendChild(add('span', '', r.owner));\n        if (r.due) m.appendChild(add('span', '', fmtDate(r.due)));\n        it.appendChild(m);\n        cell.appendChild(it);\n      });\n      el.appendChild(cell);\n    });\n  });\n});\n\ndash.draw('dates', (el) => {\n  const d = dash.data('plans');\n  el.replaceChildren();\n  if (d.status !== 'ok') return;\n  d.data.filter((r) => r.due).sort((a, b) => a.due.localeCompare(b.due) || a.plan.localeCompare(b.plan)).forEach((r) => {\n    const li = document.createElement('li');\n    const dd = document.createElement('span'); dd.className = 'd'; dd.textContent = fmtDate(r.due);\n    const t = document.createElement('span'); t.textContent = r.plan + ' ';\n    const w = document.createElement('span'); w.className = 'w'; w.textContent = r.workstream;\n    t.appendChild(w); li.append(dd, t); el.appendChild(li);\n  });\n});\n</script>\n"}